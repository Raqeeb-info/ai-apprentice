# ---- Brain (pick ONE provider) ----
# Option A: Claude (recommended – you have Anthropic credits)
ANTHROPIC_API_KEY=sk-ant-...
LLM_PROVIDER=anthropic
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001
CLAUDE_SMART_MODEL=claude-sonnet-5-5

# Option B: Kimi / any OpenAI-compatible API
# LLM_PROVIDER=openai-compatible
# OPENAI_COMPAT_BASE_URL=https://api.moonshot.ai/v1
# OPENAI_COMPAT_API_KEY=sk-...
# OPENAI_COMPAT_FAST_MODEL=kimi-k2-turbo-preview
# OPENAI_COMPAT_SMART_MODEL=kimi-k2-turbo-preview

# Option C: nothing. Leave all keys empty → offline mock brain (demo still works end-to-end).
# LLM_PROVIDER=mock

# ---- Voice (ElevenLabs). Leave empty to use the browser's own speech (fallback). ----
ELEVENLABS_API_KEY=
ELEVENLABS_INTERVIEWER_AGENT_ID=
ELEVENLABS_TUTOR_AGENT_ID=

PORT=3000
